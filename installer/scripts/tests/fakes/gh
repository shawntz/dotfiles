#!/bin/bash
# Stands in for the GitHub CLI's release commands. Every call goes to $FAKE_LOG.
# FAKE_GH_RELEASE says what GitHub holds for the tag: none (the default), draft or published.
# FAKE_GH_FAIL names a subcommand (create, edit, delete) that fails.
set -eu
printf 'gh %s\n' "$*" >>"$FAKE_LOG"
[ "${1:-}" = release ] || { echo "fake gh: unexpected arguments: $*" >&2; exit 1; }
if [ "${FAKE_GH_FAIL:-}" = "${2:-}" ]; then
    echo "fake gh: release $2 failed" >&2
    exit 1
fi
case "${2:-}" in
    view)
        case "${FAKE_GH_RELEASE:-none}" in
            draft) echo true ;;
            published) echo false ;;
            *) echo "release not found" >&2; exit 1 ;;
        esac ;;
    create)
        # The notes file is gone when the script ends, so keep what it said.
        previous=""
        for argument in "$@"; do
            [ "$previous" != --notes-file ] || cp "$argument" "$FAKE_LOG.notes"
            previous="$argument"
        done
        echo "https://github.com/test/repo/releases/tag/untagged-0123456789" ;;
    edit | delete) ;;
    *) echo "fake gh: unexpected arguments: $*" >&2; exit 1 ;;
esac
